# Copia a .env y completa. Nunca se versiona .env (INV_SIN_SECRETOS_EN_REPO).
# Las variables con valor por defecto en los YAML pueden quedar vacías.
# © 2026 Juan Carlos Proaño. Todos los derechos reservados.

# Aplicación
APP_ENV=beta
LOG_NIVEL=INFO
PANEL_DOMAIN=localhost
PANEL_URL=http://localhost:8080/panel
PANEL_SESSION_SECRET=

# Base de datos (PostgreSQL 16 gestionado con pgvector; Cloud SQL en GCP / postgres-beta en local)
# En Cloud Run (GCP Cloud SQL mediante socket UNIX):
# DATABASE_URL=postgresql://glamping_app:PASSWORD@/glamping_prod?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME
# En desarrollo local con Docker Compose (postgres-beta en puerto 5433):
# DATABASE_URL=postgresql://glamping:${POSTGRES_BETA_PASSWORD}@127.0.0.1:5433/glamping_beta
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_BETA_PASSWORD=

# WhatsApp Cloud API (Meta)
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

# Canal de vendedores (ARM Jarvis y Comisiones)
CANAL_VENDEDORES_MODO=uno_a_uno
CANAL_VENDEDORES_GRUPO_ID=

# Infraestructura GCP (Cloud Run, Cloud SQL)
GCP_PROJECT_ID=glamping-imbabura
GCP_LOCATION=us-central1

# Inferencia: Gemini en Vertex AI (ADR-0021). Autenticación por ADC, sin clave de API:
# GOOGLE_API_KEY o GEMINI_API_KEY presentes hacen fallar cerrada a la sala. Los modelos viven en
# features/inferencia/config_inferencia.yaml.
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us
# Tope diario de gasto en inferencia (USD).
COSTO_DIARIO_MAX=20

# Corpus privado del RAG: fuera del repositorio público
CORPUS_DIR=datos_privados/corpus

# Embeddings del RAG (TASK-002)
EMBEDDINGS_PROVEEDOR=
EMBEDDINGS_MODELO=

# Seguridad
PII_VAULT_KEY=

# Almacenamiento de archivos S3-compatible
S3_ENDPOINT=
S3_BUCKET=

# PMS (ADR-0007)
PMS_PROVEEDOR=fake
PMS_HOST=
PMS_URL=
PMS_TOKEN=

# CRM (ADR-0008)
CRM_PROVEEDOR=fake
CRM_HOST=
CRM_URL=
CRM_TOKEN=
CRM_LOCATION_ID=
CRM_INBOUND_WEBHOOK_URL=
CRM_HMAC_SECRET=
CRM_EVENTS_SECRET=

# Servidor MCP y observabilidad
MCP_TRANSPORTE=stdio
COSTO_DIARIO_MAX=20

# Avisos de la terminal móvil
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Web pública
WEB_PUBLICA_URL=http://localhost:8080
WEB_CATALOGO_RUTA=features/web_huespedes/catalogo_ejemplo.yaml
WEB_WHATSAPP_NUMERO=
WEB_IP_HMAC_SECRET=
