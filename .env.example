# Copia a .env y completa. Nunca se versiona .env (INV_SIN_SECRETOS_EN_REPO).
# Las variables con valor por defecto en los YAML pueden quedar vacías.

# Aplicación
APP_ENV=beta
LOG_NIVEL=INFO
PANEL_DOMAIN=localhost
PANEL_URL=http://localhost:8080/panel
PANEL_SESSION_SECRET=

# Base de datos (PostgreSQL gestionado con pgvector; en beta local, postgres-beta)
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_BETA_PASSWORD=

# WhatsApp Cloud API (Meta)
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=

# Canal de vendedores (ARM Jarvis y Comisiones)
CANAL_VENDEDORES_MODO=uno_a_uno
CANAL_VENDEDORES_GRUPO_ID=

# Modelos de Lenguaje (Google Gemini en GCP / Anthropic Claude)
PROVEEDOR_LLM=google
GEMINI_API_KEY=
GCP_PROJECT_ID=glamping-imbabura
GCP_LOCATION=us-central1
ANTHROPIC_API_KEY=
MODELO_PRINCIPAL=gemini-3.8-flash
MODELO_ECONOMICO=gemini-3.5-flash-lite
MODELO_GEMINI_PRINCIPAL=gemini-3.8-flash
MODELO_GEMINI_ECONOMICO=gemini-3.5-flash-lite

# Corpus privado del RAG: fuera del repositorio público
CORPUS_DIR=datos_privados/corpus

# Embeddings del RAG (TASK-002)
EMBEDDINGS_PROVEEDOR=
EMBEDDINGS_MODELO=

# Seguridad
PII_VAULT_KEY=

# Almacenamiento de archivos S3-compatible
S3_ENDPOINT=
S3_BUCKET=

# PMS (ADR-0007)
PMS_PROVEEDOR=fake
PMS_HOST=
PMS_URL=
PMS_TOKEN=

# CRM (ADR-0008)
CRM_PROVEEDOR=fake
CRM_HOST=
CRM_URL=
CRM_TOKEN=
CRM_LOCATION_ID=
CRM_INBOUND_WEBHOOK_URL=
CRM_HMAC_SECRET=
CRM_EVENTS_SECRET=

# Servidor MCP y observabilidad
MCP_TRANSPORTE=stdio
COSTO_DIARIO_MAX=20

# Avisos de la terminal móvil
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Web pública
WEB_PUBLICA_URL=http://localhost:8080
WEB_CATALOGO_RUTA=features/web_huespedes/catalogo_ejemplo.yaml
WEB_WHATSAPP_NUMERO=
WEB_IP_HMAC_SECRET=
