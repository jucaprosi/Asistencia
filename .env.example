# Copia a .env y completa. Nunca se versiona .env (INV_SIN_SECRETOS_EN_REPO).
# Las variables con valor por defecto en los YAML pueden quedar vacías.

# Aplicación
APP_ENV=beta
LOG_NIVEL=INFO
PANEL_DOMAIN=localhost
PANEL_URL=http://localhost:8080/panel
PANEL_SESSION_SECRET=

# Base de datos (PostgreSQL gestionado con pgvector; en beta local, postgres-beta)
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_BETA_PASSWORD=

# WhatsApp Cloud API (Meta)
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=
META_APP_SECRET=
CANAL_VENDEDORES_MODO=uno_a_uno
CANAL_VENDEDORES_GRUPO_ID=

# Modelo (Anthropic)
ANTHROPIC_API_KEY=
MODELO_PRINCIPAL=
MODELO_ECONOMICO=

# Corpus privado del RAG: fuera del repositorio público
CORPUS_DIR=datos_privados/corpus

# Embeddings del RAG (TASK-002)
EMBEDDINGS_PROVEEDOR=
EMBEDDINGS_MODELO=

# Seguridad
PII_VAULT_KEY=

# Almacenamiento de archivos S3-compatible
S3_ENDPOINT=
S3_BUCKET=

# PMS (ADR-0007)
PMS_PROVEEDOR=fake
PMS_HOST=
PMS_URL=
PMS_TOKEN=

# CRM (ADR-0008)
CRM_PROVEEDOR=fake
CRM_HOST=
CRM_URL=
CRM_TOKEN=
CRM_LOCATION_ID=
CRM_INBOUND_WEBHOOK_URL=
CRM_HMAC_SECRET=
CRM_EVENTS_SECRET=

# Servidor MCP y observabilidad
MCP_TRANSPORTE=stdio
COSTO_DIARIO_MAX=20
