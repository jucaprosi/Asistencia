{
  "nombre": "consultar_comision_propia",
  "descripcion": "Consulta el acumulado de comisiones validadas y pendientes del vendedor para un período.",
  "sala_destino": "arm_jarvis",
  "roles": ["vendedor"],
  "entrada": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "periodo": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
      }
    }
  },
  "salida": {
    "type": "object",
    "additionalProperties": false,
    "required": ["validada", "pendiente", "ventas", "periodo"],
    "properties": {
      "validada": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
      "pendiente": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
      "ventas": {"type": "integer"},
      "periodo": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"}
    }
  }
}
