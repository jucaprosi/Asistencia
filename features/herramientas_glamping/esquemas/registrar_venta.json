{
  "nombre": "registrar_venta",
  "descripcion": "Registra una venta extraída estructuradamente por el agente en la sala arm_jarvis.",
  "sala_destino": "arm_jarvis",
  "roles": ["vendedor"],
  "entrada": {
    "type": "object",
    "additionalProperties": false,
    "required": ["texto_original", "venta"],
    "properties": {
      "texto_original": {"type": "string"},
      "venta": {
        "type": "object",
        "additionalProperties": false,
        "required": ["es_venta", "moneda", "confianza", "confianza_campos", "campos_faltantes"],
        "properties": {
          "es_venta": {"type": "boolean"},
          "cliente_token": {"type": ["string", "null"]},
          "telefono_cliente_token": {"type": ["string", "null"]},
          "producto": {"type": ["string", "null"]},
          "propiedad_id": {"type": ["string", "null"]},
          "noches": {"type": ["integer", "null"], "minimum": 1},
          "monto": {
            "oneOf": [
              {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
              {"type": "null"}
            ]
          },
          "moneda": {"const": "USD"},
          "fecha_venta": {"type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "fecha_llegada": {"type": ["string", "null"], "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "confianza": {"type": "number", "minimum": 0, "maximum": 1},
          "confianza_campos": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "campos_faltantes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  },
  "salida": {
    "type": "object",
    "additionalProperties": false,
    "required": ["ticket", "estado", "posible_duplicado"],
    "properties": {
      "ticket": {"type": "string", "pattern": "^V-[0-9]{4}-[0-9]{4,}$"},
      "estado": {"const": "por_validar"},
      "comision_estimada": {"type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$"},
      "posible_duplicado": {"type": "boolean"}
    }
  }
}
